{
  "name": "mangotv-web",
  "version": "0.1.0",
  "private": true,
  "description": "MangoTV for the web — a faithful browser port of the MangoTV Fire TV app, backed by the existing MangoTV API.",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client && npm run build --workspace server",
    "start": "npm run start --workspace server",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces && tsc -p e2e/tsconfig.json",
    "test": "npm run test --workspaces",
    "test:integration": "bash scripts/run-backend-integration.sh",
    "test:e2e": "bash scripts/run-e2e.sh",
    "verify:backend": "node scripts/verify-backend.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0"
  }
}
