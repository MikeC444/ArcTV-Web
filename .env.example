# Copy to .env (never commit .env). Placeholders only — no real values here.

# --- Web server (server/) -------------------------------------------------
# Public HTTPS base URL of the EXISTING MangoTV API (the same value the Fire TV
# build uses as API_BASE_URL). Required. No trailing slash.
MANGOTV_API_URL=

# Secret used to seal the httpOnly session cookie (AES-256-GCM key derivation).
# Required in production; generate with:  openssl rand -base64 48
SESSION_SECRET=

# development | production. `production` enables Secure cookies + HSTS.
NODE_ENV=development

# Port the web server listens on.
PORT=8080

# How many reverse proxies sit in front of the server, 0-3 (0 = none). Many hosts: 1. Render sends two addresses
# (a CDN in front of its proxy), so it usually needs 2 — the [proxy] line in the start-up log says which value fits.
TRUST_PROXY=1

# Optional: comma-separated extra origins allowed to be embedded/connect (CSP).
# Leave empty unless you know you need it.
CSP_EXTRA_CONNECT_SRC=

# Stream relay (Stremio-style /proxy/): lets signed-in users play sources that need
# addon request headers, are plain http, or whose host refuses a browser's own
# request. Relayed video flows through this server (bandwidth). "0" turns it off.
STREAM_RELAY=1

# Optional: a free TMDB key (https://www.themoviedb.org/settings/api) turns on the built-in
# "Mango TV Catalog" addon (Trending / Popular / Top Rated / genres with TMDB artwork) for every
# user, without touching anyone's account. Leave empty to keep it off.
TMDB_API_KEY=
