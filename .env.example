# Copy to .env (never commit .env). Placeholders only — no real values here.

# --- Web server (server/) -------------------------------------------------
# Public HTTPS base URL of the EXISTING MangoTV API (the same value the Fire TV
# build uses as API_BASE_URL). Required. No trailing slash.
MANGOTV_API_URL=

# Secret used to seal the httpOnly session cookie (AES-256-GCM key derivation).
# Required in production; generate with:  openssl rand -base64 48
SESSION_SECRET=

# development | production. `production` enables Secure cookies + HSTS.
NODE_ENV=development

# Port the web server listens on.
PORT=8080

# Set to "1" when the server sits behind exactly one reverse proxy (most PaaS).
TRUST_PROXY=1

# Optional: comma-separated extra origins allowed to be embedded/connect (CSP).
# Leave empty unless you know you need it.
CSP_EXTRA_CONNECT_SRC=
